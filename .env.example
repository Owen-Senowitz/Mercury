# Local development settings for docker-compose.yml.
# Copy this file to .env and adjust if needed:  cp .env.example .env
#
# Every value here is for LOCAL DEVELOPMENT ONLY. The database is bound to
# 127.0.0.1 and never reachable from the network. Do not reuse these values in
# any shared, staging or production environment, and never commit a real .env.

# Database created on first start by the postgres container.
POSTGRES_DB=mercury

# Application role the API connects as.
POSTGRES_USER=mercury_app

# Local-only password. Change it if you like; nothing depends on this value.
POSTGRES_PASSWORD=local_dev_only_password

# Host port for PostgreSQL. Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# Host port for Adminer, started only with: docker compose --profile tools up -d
ADMINER_PORT=8080
